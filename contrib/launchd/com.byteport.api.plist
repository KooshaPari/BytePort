# BytePort API LaunchDaemon (macOS service registration)
# Installation:
#   sudo cp contrib/launchd/com.byteport.api.plist /Library/LaunchDaemons/
#   sudo launchctl load -w /Library/LaunchDaemons/com.byteport.api.plist
#   sudo launchctl start com.byteport.api
#   tail -f /var/log/byteport/api.log
#
# This LaunchDaemon runs the BytePort API as a privileged system service.

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.byteport.api</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/byteport-api</string>
        <string>--config=/etc/byteport/api.yaml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>0</integer>

    <key>UserName</key>
    <string>byteport</string>

    <key>GroupName</key>
    <string>byteport</string>

    <key>WorkingDirectory</key>
    <string>/var/lib/byteport</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>ENV</key>
        <string>production</string>
        <key>LOG_LEVEL</key>
        <string>info</string>
        <key>PORT</key>
        <string>8080</string>
        <key>OTEL_SERVICE_NAME</key>
        <string>byteport-api</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/var/log/byteport/api.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/byteport/api.err</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>

    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>131072</integer>
        <key>NumberOfProcesses</key>
        <integer>4096</integer>
    </dict>

    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockServiceName</key>
            <string>8080</string>
            <key>SockType</key>
            <string>stream</string>
            <key>SockFamily</key>
            <string>IPv4</string>
        </dict>
    </dict>
</dict>
</plist>
