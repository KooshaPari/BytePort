{
  "title": "BytePort Operations — Grafana Cloud",
  "uid": "byteport-ops",
  "version": "1.0.0",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["byteport", "production"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "P95 API Latency",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(byteport_http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deployment Success Rate (1h)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "(sum(increase(byteport_deployments_total{status=\"success\"}[1h])) / sum(increase(byteport_deployments_total[1h])))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.98 }] } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active Deployments",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "byteport_active_deployments", "refId": "A", "legendFormat": "{{region}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Compute Spend (USD/hour)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (provider) (byteport_cost_dollars_per_hour)", "refId": "A", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Error Rates by Endpoint",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "topk(10, sum by (route, method) (rate(byteport_http_requests_total{status=~\"5..\"}[5m])))",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
